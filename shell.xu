fn cmd_poweroff_h(coop_ok bool) {
    serial_puts("[KERNEL] Powering off QEMU...\n")
    unsafe {
        arch.out16(u16(0x0604), u16(0x2000))
        arch.out16(u16(0xB004), u16(0x2000))
    }
    arch.cli()
    kernel_halt_forever()
}

static shell_cmds [NUM_SHELL_CMDS]ShellCmd = [
    ShellCmd{name: "help",      desc: "Show this command list",                            handler: (cmd_help_h) as *raw u8},
    ShellCmd{name: "info",      desc: "Show CPU, BootInfo, CR3, and IRQ stats",            handler: (cmd_info_h) as *raw u8},
    ShellCmd{name: "mem",       desc: "Show PMM, VMM, and Heap allocator stats",           handler: (cmd_mem_h) as *raw u8},
    ShellCmd{name: "ps",        desc: "Show preemptive task table and worker counters",    handler: (cmd_ps_h) as *raw u8},
    ShellCmd{name: "uptime",    desc: "Show PIT timer ticks (100 Hz)",                     handler: (cmd_uptime_h) as *raw u8},
    ShellCmd{name: "vmtest",    desc: "Run 4-level VMM map/RW/translate/unmap test",       handler: (cmd_vmtest_h) as *raw u8},
    ShellCmd{name: "heaptest",  desc: "Run kmalloc/kfree split & coalesce test",           handler: (cmd_heaptest_h) as *raw u8},
    ShellCmd{name: "usertest",  desc: "Run Ring 3 user mode & SYSCALL/SYSRET test",        handler: (cmd_usertest_h) as *raw u8},
    ShellCmd{name: "blktest",   desc: "Run VirtIO-Blk PCI DMA read/write test",            handler: (cmd_blktest_h) as *raw u8},
    ShellCmd{name: "ls",        desc: "List files in persistent XuFS filesystem",          handler: (cmd_ls_h) as *raw u8},
    ShellCmd{name: "cat",       desc: "Print /etc/motd from XuFS",                         handler: (cmd_cat_h) as *raw u8},
    ShellCmd{name: "fstest",    desc: "Run persistent XuFS read/write/remount test",       handler: (cmd_fstest_h) as *raw u8},
    ShellCmd{name: "elftest",   desc: "Load & run pure-Xu Ring 3 ELF64 (/bin/hello.elf)",  handler: (cmd_elftest_h) as *raw u8},
    ShellCmd{name: "pftest",    desc: "Run demand paging & Ring 3 #PF containment test",   handler: (cmd_pftest_h) as *raw u8},
    ShellCmd{name: "linuxtest", desc: "Run unmodified Linux x86_64 ELF64 guest app",       handler: (cmd_linuxtest_h) as *raw u8},
    ShellCmd{name: "mactest",   desc: "Run unmodified macOS x86_64 Mach-O guest app",      handler: (cmd_mactest_h) as *raw u8},
    ShellCmd{name: "uitest",    desc: "Run #ui/widgets Ring 3 smoke test (Linux+macOS)",   handler: (cmd_uitest_h) as *raw u8},
    ShellCmd{name: "ui",        desc: "Launch #ui/widgets Ring 3 desktop (Linux ELF64)",   handler: (cmd_ui_h) as *raw u8},
    ShellCmd{name: "uimac",     desc: "Launch #ui/widgets Ring 3 desktop (macOS Mach-O)",  handler: (cmd_uimac_h) as *raw u8},
    ShellCmd{name: "clear",     desc: "Clear GUI terminal screen",                         handler: (cmd_clear_h) as *raw u8},
    ShellCmd{name: "spawn",     desc: "Spawn dynamic kernel worker task",                  handler: (cmd_spawn_h) as *raw u8},
    ShellCmd{name: "selftest",  desc: "Run full 15-part OS verification suite",            handler: (cmd_selftest_h) as *raw u8},
    ShellCmd{name: "poweroff",  desc: "Cleanly shut down QEMU",                            handler: (cmd_poweroff_h) as *raw u8}
]

fn shell_dispatch(buf *raw u8, len int, coop_ok bool) {
    if len == 0 {
        <<
    }
    for idx in 0:NUM_SHELL_CMDS {
        $matched := false
        unsafe {
            matched = cmd_name_eq(buf, len, (&shell_cmds[idx].name[0]) as *raw u8)
        }
        if matched {
            $h := cmd_help_h
            unsafe {
                h = (shell_cmds[idx].handler) as fn(bool)
            }
            h(coop_ok)
            <<
        }
    }
    serial_puts("Unknown command: ")
    serial_put_buf(buf, len)
    serial_puts(" (type 'help')\n")
}

@noreturn
pub fn shell_run() {
    $coop_ok := false
    $buf := 0 as *raw u8
    unsafe {
        mem.memset((($&g_shell_state) as *raw ShellState) as *raw u8, u8(0), sizeof(ShellState))
        buf = ($&shell_buf[0]) as *raw u8
        mem.memset(buf, u8(0), sizeof([SHELL_RING_CAP]u8))
        ds := demo_state()
        coop_ok = (*ds).coop_step == 1
        st := shell_state()
        *st = ShellState{
            line_len: 0,
            cmd_count: u64(0),
            running: 1
        }
    }

    if boot_auto_ui() && fb_is_ready() {
        user_run_desktop_session(false)
    }

    serial_puts("\nxu-os> ")
    gui_force_redraw()

    while true {
        gui_tick()

        gui_cmd_len := gui_poll_command(buf, SHELL_BUF_CAP)
        if gui_cmd_len > 0 {
            serial_put_buf(buf, gui_cmd_len)
            serial_puts("\n")
            unsafe {
                st := shell_state()
                (*st).line_len = 0
                (*st).cmd_count += u64(1)
            }
            shell_dispatch(buf, gui_cmd_len, coop_ok)
            serial_puts("xu-os> ")
            gui_force_redraw()
            ->
        }

        $ch := serial_try_getc()
        if ch < 0 {
            ch = kbd_try_getc()
        }
        if ch < 0 {
            arch.halt()
            ->
        }

        if ch == 13 || ch == 10 {
            serial_puts("\n")
            $len := 0
            unsafe {
                st := shell_state()
                len = (*st).line_len
                (*st).line_len = 0
                (*st).cmd_count += u64(1)
            }
            shell_dispatch(buf, len, coop_ok)
            serial_puts("xu-os> ")
            gui_force_redraw()
        } else if ch == 8 || ch == 127 {
            unsafe {
                st := shell_state()
                if (*st).line_len > 0 {
                    (*st).line_len -= 1
                    serial_putc(u8(8))
                    serial_putc(u8(32))
                    serial_putc(u8(8))
                }
            }
        } else if ch >= 32 && ch < 127 {
            unsafe {
                st := shell_state()
                if (*st).line_len < SHELL_BUF_CAP {
                    p := ((buf as int) + (*st).line_len) as *raw u8
                    *p = u8(ch)
                    (*st).line_len += 1
                    serial_putc(u8(ch))
                }
            }
        }
    }
}
