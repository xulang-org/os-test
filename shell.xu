fn cmd_spawn_h(coop_ok bool) {
    tid := sched_spawn("dyn_worker", dyn_worker_entry as u64)
    if tid >= 0 {
        serial_puts("[SCHED] Spawned dyn_worker tid=")
        serial_put_dec(tid)
        serial_puts("\n")
    } else {
        serial_puts("[SCHED] Spawn failed\n")
    }
}

fn cmd_ls_h(coop_ok bool) {
    fs_list()
}

fn cmd_cat_h(coop_ok bool) {
    motd := "/etc/motd"
    page := pmm_alloc_frame()
    if page == u64(0) {
        serial_puts("[FS] Out of memory\n")
        <<
    }
    p_path := page as *raw u8
    p_out := (page + u64(128)) as *raw u8
    unsafe {
        for i in 0:motd.len {
            *(((p_path as usize) + usize(i)) as *raw u8) = u8(motd[i])
        }
    }
    n := fs_read(p_path, motd.len, p_out, 256)
    if n > 0 {
        serial_put_buf(p_out, n)
    } else {
        serial_puts("[FS] Failed to read /etc/motd\n")
    }
    pmm_free_frame(page)
}

