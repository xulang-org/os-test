@main
$freestanding

#core/acpi
#core/arch
#core/mem
#core/sync

extern "C" {
    let ap_trampoline_start u8
    let ap_trampoline_end u8
}

@align(16)
static $ap_stack [16384]u8

@repr("C")
pub struct PerCpu {
    pub cpu_id u64
    pub apic_id u64
    pub ipi_hits u64
    pub timer_hits u64
}

static $g_percpu [2]PerCpu
static $g_smp_lapic_base u64
static $g_smp_lock sync.TicketLock
static $g_smp_shared u64
static $g_smp_ap_online sync.AtomicU64
static $g_smp_ap_id sync.AtomicU64
static $g_smp_cmd sync.AtomicU64
static $g_smp_ack sync.AtomicU64
static $g_smp_ipi_count sync.AtomicU64
static $g_smp_ipi_cpu sync.AtomicU64
static $g_smp_timer_count sync.AtomicU64
static $g_ap_timer_ticks sync.AtomicU64
static $g_tlb_shootdown_va sync.AtomicU64
static $g_tlb_shootdown_ack sync.AtomicU64
static $g_ap_peek_va sync.AtomicU64
static $g_ap_peek_val sync.AtomicU64
static $g_ap_peek_done sync.AtomicU64
static $g_job_lock sync.TicketLock
static $g_job_queue [8]u64
static $g_job_head u64
static $g_job_tail u64
static $g_job_sum sync.AtomicU64
static $g_job_done sync.AtomicU64
@align(16)
static $g_fxsave_orig [512]u8
@align(16)
static $g_fxsave_test [512]u8
@align(16)
static $g_fxsave_read [512]u8

@interrupt
pub fn smp_ipi82_isr() {
    unsafe {
        cid := arch.gs_read_u64(u64(0))
        g_smp_ipi_cpu.store(cid)
        g_smp_ipi_count.fetch_add(u64(1))
        if g_smp_lapic_base != u64(0) {
            arch.lapic_eoi(g_smp_lapic_base)
        }
    }
}

@interrupt
pub fn smp_lapic_timer_isr() {
    unsafe {
        if g_smp_lapic_base != u64(0) {
            if u64(arch.lapic_id(g_smp_lapic_base)) == g_smp_ap_id.load() && g_smp_ap_online.load() != u64(0) {
                g_ap_timer_ticks.fetch_add(u64(1))
            } else {
                g_smp_timer_count.fetch_add(u64(1))
            }
            arch.lapic_eoi(g_smp_lapic_base)
        }
    }
}

@interrupt
pub fn smp_tlb_shootdown_isr() {
    unsafe {
        va := g_tlb_shootdown_va.load()
        arch.invlpg(va)
        g_tlb_shootdown_ack.fetch_add(u64(1))
        if g_smp_lapic_base != u64(0) {
            arch.lapic_eoi(g_smp_lapic_base)
        }
    }
}

@noreturn
@export("smp_ap_main")
pub fn smp_ap_main() {
    unsafe {
        lapic := g_smp_lapic_base
        $aid := u64(0)
        if lapic != u64(0) {
            arch.lapic_enable(lapic, u8(0xFF))
            aid = u64(arch.lapic_id(lapic))
            g_smp_ap_id.store(aid)
        }
        g_percpu[1] = PerCpu{
            cpu_id: u64(1),
            apic_id: aid,
            ipi_hits: u64(0),
            timer_hits: u64(0)
        }
        arch.wrmsr(u32(arch.MSR_IA32_GS_BASE), (($&g_percpu[1]) as *raw PerCpu) as u64)
        g_smp_ap_online.store(u64(1))
        arch.sti()
        if lapic != u64(0) {
            arch.lapic_timer_init(lapic, u8(0x83), u32(0x3), u32(400000), true)
        }

        while true {
            $has_job := false
            $job_arg := u64(0)
            if volatile_read((($&g_job_head) as *raw u64)) != volatile_read((($&g_job_tail) as *raw u64)) {
                _jg := g_job_lock.acquire()
                if g_job_head != g_job_tail {
                    slot := int(g_job_head & u64(7))
                    job_arg = g_job_queue[slot]
                    g_job_head += u64(1)
                    has_job = true
                }
            }
            if has_job {
                g_job_sum.fetch_add(job_arg)
                g_job_done.fetch_add(u64(1))
            } else {
                cmd := g_smp_cmd.load()
                if cmd == u64(1) {
                    $k := 0
                    while k < 20000 {
                        if true {
                            _g := g_smp_lock.acquire()
                            g_smp_shared += u64(1)
                        }
                        k += 1
                    }
                    g_smp_cmd.store(u64(0))
                    g_smp_ack.fetch_add(u64(1))
                } else if cmd == u64(2) {
                    va := g_ap_peek_va.load()
                    val := volatile_read(va as *raw u64)
                    g_ap_peek_val.store(val)
                    g_smp_cmd.store(u64(0))
                    g_ap_peek_done.fetch_add(u64(1))
                } else {
                    arch.pause()
                }
            }
        }
    }
}

fn smp_delay(iters int) {
    $i := 0
    unsafe {
        while i < iters {
            arch.pause()
            i += 1
        }
    }
}

pub fn smp_self_test() bool {
    rsdp := acpi.find_rsdp()
    if rsdp == u64(0) {
        serial_puts("[SMP] FAIL: ACPI RSDP not found\n")
        << false
    }
    madt_addr := acpi.find_table(rsdp, u8(65), u8(80), u8(73), u8(67)) // "APIC"
    if madt_addr == u64(0) {
        serial_puts("[SMP] FAIL: ACPI MADT not found\n")
        << false
    }
    $madt := acpi.MadtInfo{
        lapic_addr: u64(0),
        ioapic_addr: u64(0),
        ioapic_id: u8(0),
        ioapic_gsi_base: u32(0),
        lapic_count: 0,
        lapic_ids: [32]u8{},
        iso_count: 0,
        isos: [16]acpi.MadtIso{}
    }
    $madt_ok := false
    unsafe {
        madt_ok = acpi.parse_madt(madt_addr, ($&madt) as *raw acpi.MadtInfo)
    }
    if !madt_ok {
        serial_puts("[SMP] FAIL: parse_madt failed\n")
        << false
    }
    if madt.lapic_count < 2 || madt.ioapic_addr == u64(0) || madt.lapic_addr == u64(0) {
        serial_puts("[SMP] FAIL: MADT reports <2 CPUs or missing IOAPIC\n")
        << false
    }

    mmio_flags := u64(VMM_PAGE_WRITABLE | VMM_PAGE_PCD | VMM_PAGE_PWT) | vmm_nx_bit()
    if !vmm_map_page(vmm_kernel_pml4(), madt.lapic_addr, madt.lapic_addr, mmio_flags) {
        serial_puts("[SMP] FAIL: map LAPIC\n")
        << false
    }
    if !vmm_map_page(vmm_kernel_pml4(), madt.ioapic_addr, madt.ioapic_addr, mmio_flags) {
        serial_puts("[SMP] FAIL: map IOAPIC\n")
        << false
    }

    ioapic_ver := arch.ioapic_version(madt.ioapic_addr)
    ioapic_max := arch.ioapic_max_redir(madt.ioapic_addr)
    if ioapic_ver == u32(0) {
        serial_puts("[SMP] FAIL: invalid IOAPIC version\n")
        << false
    }

    arch.lapic_enable(madt.lapic_addr, u8(0xFF))
    bsp_id := u8(arch.lapic_id(madt.lapic_addr))

    $ap_id := u8(0)
    $found_ap := false
    for ci in 0:madt.lapic_count {
        if madt.lapic_ids[ci] != bsp_id {
            ap_id = madt.lapic_ids[ci]
            found_ap = true
            <-
        }
    }
    if !found_ap {
        serial_puts("[SMP] FAIL: no secondary APIC ID found\n")
        << false
    }

    unsafe {
        orig_gs := arch.rdmsr(u32(arch.MSR_IA32_GS_BASE))
        g_percpu[0] = PerCpu{
            cpu_id: u64(0),
            apic_id: u64(bsp_id),
            ipi_hits: u64(0),
            timer_hits: u64(0)
        }
        arch.wrmsr(u32(arch.MSR_IA32_GS_BASE), (($&g_percpu[0]) as *raw PerCpu) as u64)
        if arch.gs_read_u64(u64(0)) != u64(0) || arch.gs_read_u64(u64(8)) != u64(bsp_id) {
            arch.wrmsr(u32(arch.MSR_IA32_GS_BASE), orig_gs)
            serial_puts("[SMP] FAIL: BSP PerCpu GS base mismatch\n")
            << false
        }

        g_smp_lapic_base = madt.lapic_addr
        idt_set_gate_pub(0x82, (smp_ipi82_isr as *raw u8) as u64, u8(arch.IDT_ATTR_INT32))
        idt_set_gate_pub(0x83, (smp_lapic_timer_isr as *raw u8) as u64, u8(arch.IDT_ATTR_INT32))
        idt_set_gate_pub(0x84, (smp_tlb_shootdown_isr as *raw u8) as u64, u8(arch.IDT_ATTR_INT32))

        if g_smp_ap_online.load() == u64(0) {
            t_start := ((&ap_trampoline_start) as *raw u8) as u64
            t_end := ((&ap_trampoline_end) as *raw u8) as u64
            t_len := int(t_end - t_start)
            mem.memcpy(u64(0x8000) as *raw u8, t_start as *raw u8, t_len)

            stack_top := ((($&ap_stack[0]) as *raw u8) as u64) + u64(16384)
            entry_addr := (smp_ap_main as *raw u8) as u64
            idtr_ptr := idt_pointer_addr()

            *(u64(0x8F00) as *raw u64) = vmm_kernel_pml4()
            *(u64(0x8F08) as *raw u64) = stack_top
            *(u64(0x8F10) as *raw u64) = entry_addr
            *(u64(0x8F18) as *raw u64) = idtr_ptr

            arch.lapic_send_init(madt.lapic_addr, ap_id)
            smp_delay(200000)
            arch.lapic_send_sipi(madt.lapic_addr, ap_id, u8(0x08))
            smp_delay(100000)
            if g_smp_ap_online.load() == u64(0) {
                arch.lapic_send_sipi(madt.lapic_addr, ap_id, u8(0x08))
            }

            $tries := 0
            while g_smp_ap_online.load() == u64(0) && tries < 20000000 {
                arch.pause()
                tries += 1
            }
            if g_smp_ap_online.load() == u64(0) {
                arch.wrmsr(u32(arch.MSR_IA32_GS_BASE), orig_gs)
                serial_puts("[SMP] FAIL: AP did not come online\n")
                << false
            }
        }

        // Dual-core TicketLock contention stress: 20,000 increments on BSP + 20,000 on AP.
        g_smp_shared = u64(0)
        prev_ack := g_smp_ack.load()
        g_smp_cmd.store(u64(1))
        $bk := 0
        while bk < 20000 {
            if true {
                _g := g_smp_lock.acquire()
                g_smp_shared += u64(1)
            }
            bk += 1
        }
        $wait_ack := 0
        while g_smp_ack.load() <= prev_ack && wait_ack < 20000000 {
            arch.pause()
            wait_ack += 1
        }
        if g_smp_shared != u64(40000) {
            arch.wrmsr(u32(arch.MSR_IA32_GS_BASE), orig_gs)
            serial_puts("[SMP] FAIL: TicketLock shared_counter=")
            serial_put_dec(int(g_smp_shared))
            serial_puts(" (expected 40000)\n")
            << false
        }

        // Cross-core LAPIC Fixed IPI to AP at IDT vector 0x82 (@interrupt + AP PerCpu GS)
        g_smp_ipi_cpu.store(u64(999))
        prev_ipi := g_smp_ipi_count.load()
        arch.lapic_send_ipi(madt.lapic_addr, ap_id, u8(0x82))
        $wait_ipi := 0
        while g_smp_ipi_count.load() <= prev_ipi && wait_ipi < 10000000 {
            arch.pause()
            wait_ipi += 1
        }
        if g_smp_ipi_count.load() <= prev_ipi {
            arch.wrmsr(u32(arch.MSR_IA32_GS_BASE), orig_gs)
            serial_puts("[SMP] FAIL: LAPIC IPI to AP timed out\n")
            << false
        }
        ipi_cid := g_smp_ipi_cpu.load()
        if ipi_cid != u64(1) {
            arch.wrmsr(u32(arch.MSR_IA32_GS_BASE), orig_gs)
            serial_puts("[SMP] FAIL: AP PerCpu GS cpu_id=")
            serial_put_dec(int(ipi_cid))
            serial_puts(" (expected 1)\n")
            << false
        }

        // Hardware LAPIC one-shot Timer IRQ at vector 0x83
        prev_tmr := g_smp_timer_count.load()
        arch.lapic_timer_init(madt.lapic_addr, u8(0x83), u32(0x3), u32(50000), false)
        $wait_tmr := 0
        while g_smp_timer_count.load() <= prev_tmr && wait_tmr < 20000000 {
            arch.pause()
            wait_tmr += 1
        }
        if g_smp_timer_count.load() <= prev_tmr {
            arch.wrmsr(u32(arch.MSR_IA32_GS_BASE), orig_gs)
            serial_puts("[SMP] FAIL: LAPIC timer IRQ 0x83 timed out\n")
            << false
        }

        arch.wrmsr(u32(arch.MSR_IA32_GS_BASE), orig_gs)

        serial_puts("[SMP] ACPI MADT cpus=")
        serial_put_dec(madt.lapic_count)
        serial_puts(" ioapic_ver=")
        serial_put_dec(int(ioapic_ver))
        serial_puts(" max_redir=")
        serial_put_dec(int(ioapic_max))
        serial_puts(" ap_id=")
        serial_put_dec(int(g_smp_ap_id.load()))
        serial_puts(" lock=40000 ipi=")
        serial_put_dec(int(g_smp_ipi_count.load()))
        serial_puts(" ipi_cpu=")
        serial_put_dec(int(ipi_cid))
        serial_puts(" lapic_timer=")
        serial_put_dec(int(g_smp_timer_count.load()))
        serial_puts(" OK\n")
    }
    << true
}

pub fn smp_tlb_shootdown(va u64) bool {
    unsafe {
        arch.invlpg(va)
        if g_smp_ap_online.load() == u64(0) || g_smp_lapic_base == u64(0) {
            << true
        }
        prev := g_tlb_shootdown_ack.load()
        g_tlb_shootdown_va.store(va)
        arch.lapic_send_ipi(g_smp_lapic_base, u8(g_smp_ap_id.load()), u8(0x84))
        $tries := 0
        while g_tlb_shootdown_ack.load() <= prev && tries < 20000000 {
            arch.pause()
            tries += 1
        }
        << g_tlb_shootdown_ack.load() > prev
    }
}

fn smp_ap_peek_u64(va u64, out *raw u64) bool {
    unsafe {
        prev := g_ap_peek_done.load()
        g_ap_peek_va.store(va)
        g_smp_cmd.store(u64(2))
        $tries := 0
        while g_ap_peek_done.load() <= prev && tries < 20000000 {
            arch.pause()
            tries += 1
        }
        if g_ap_peek_done.load() <= prev {
            << false
        }
        *out = g_ap_peek_val.load()
    }
    << true
}

pub fn smp_tlb_and_acpi_self_test() bool {
    unsafe {
        if g_smp_ap_online.load() == u64(0) {
            if !smp_self_test() {
                << false
            }
        }
        rsdp := acpi.find_rsdp()
        fadt_addr := acpi.find_fadt(rsdp)
        if fadt_addr == u64(0) {
            serial_puts("[SMP-TLB] FAIL: ACPI FADT not found\n")
            << false
        }
        $fadt := acpi.FadtInfo{
            sci_int: u16(0), smi_cmd: u32(0), pm1a_evt_blk: u32(0),
            pm1a_cnt_blk: u32(0), pm_tmr_blk: u32(0), flags: u32(0),
            reset_reg_addr: u64(0), reset_value: u8(0)
        }
        if !acpi.parse_fadt(fadt_addr, ($&fadt) as *raw acpi.FadtInfo) {
            serial_puts("[SMP-TLB] FAIL: parse_fadt failed\n")
            << false
        }
        if fadt.pm1a_cnt_blk == u32(0) || fadt.pm_tmr_blk == u32(0) {
            serial_puts("[SMP-TLB] FAIL: invalid FADT pm1a/pm_tmr\n")
            << false
        }
        $hpet_base := u64(0)
        hpet_addr := acpi.find_hpet(rsdp)
        if hpet_addr != u64(0) {
            $hpet := acpi.HpetInfo{
                base_addr: u64(0), min_tick: u16(0), comparator_count: u8(0),
                counter_64bit: false, vendor_id: u16(0)
            }
            if acpi.parse_hpet(hpet_addr, ($&hpet) as *raw acpi.HpetInfo) {
                hpet_base = hpet.base_addr
            }
        }

        p1 := pmm_alloc_frame()
        p2 := pmm_alloc_frame()
        if p1 == u64(0) || p2 == u64(0) {
            if p1 != u64(0) { pmm_free_frame(p1) }
            if p2 != u64(0) { pmm_free_frame(p2) }
            serial_puts("[SMP-TLB] FAIL: pmm_alloc_frame\n")
            << false
        }
        *(p1 as *raw u64) = 0x1122334455667788u64
        *(p2 as *raw u64) = 0xCAFEBABE12345678u64

        test_va := u64(0x20010000)
        flags := u64(VMM_PAGE_WRITABLE) | vmm_nx_bit()
        pml4 := vmm_kernel_pml4()
        $ok := true
        if !vmm_map_page(pml4, test_va, p1, flags) {
            ok = false
        }
        $v1 := u64(0)
        if ok && (!smp_tlb_shootdown(test_va) || !smp_ap_peek_u64(test_va, ($&v1) as *raw u64) || v1 != 0x1122334455667788u64) {
            serial_puts("[SMP-TLB] FAIL: phase 1 AP TLB read mismatch\n")
            ok = false
        }
        if ok && !vmm_map_page(pml4, test_va, p2, flags) {
            ok = false
        }
        $v2 := u64(0)
        if ok && (!smp_tlb_shootdown(test_va) || !smp_ap_peek_u64(test_va, ($&v2) as *raw u64) || v2 != 0xCAFEBABE12345678u64) {
            serial_puts("[SMP-TLB] FAIL: phase 2 AP TLB shootdown read mismatch\n")
            ok = false
        }
        vmm_unmap_page(pml4, test_va)
        smp_tlb_shootdown(test_va)
        pmm_free_frame(p1)
        pmm_free_frame(p2)
        if !ok {
            << false
        }

        $ap_ticks := g_ap_timer_ticks.load()
        $wait_ap := 0
        while ap_ticks == u64(0) && wait_ap < 5000000 {
            arch.pause()
            ap_ticks = g_ap_timer_ticks.load()
            wait_ap += 1
        }
        if ap_ticks == u64(0) {
            serial_puts("[SMP-TLB] FAIL: AP autonomous LAPIC periodic timer did not tick\n")
            << false
        }

        serial_puts("[SMP-TLB] fadt_pm1a=")
        serial_put_hex(u64(fadt.pm1a_cnt_blk))
        serial_puts(" pm_tmr=")
        serial_put_hex(u64(fadt.pm_tmr_blk))
        serial_puts(" hpet=")
        serial_put_hex(hpet_base)
        serial_puts(" shootdown=OK ap_timer_ticks=")
        serial_put_dec(int(ap_ticks))
        serial_puts(" OK\n")
    }
    << true
}

pub fn smp_hpet_and_fpu_self_test() bool {
    unsafe {
        if g_smp_ap_online.load() == u64(0) {
            if !smp_self_test() {
                << false
            }
        }
        rsdp := acpi.find_rsdp()
        hpet_addr := acpi.find_hpet(rsdp)
        if hpet_addr == u64(0) {
            serial_puts("[SMP-HPET] FAIL: ACPI HPET table not found\n")
            << false
        }
        $hpet := acpi.HpetInfo{
            base_addr: u64(0), min_tick: u16(0), comparator_count: u8(0),
            counter_64bit: false, vendor_id: u16(0)
        }
        if !acpi.parse_hpet(hpet_addr, ($&hpet) as *raw acpi.HpetInfo) || hpet.base_addr == u64(0) {
            serial_puts("[SMP-HPET] FAIL: parse_hpet failed\n")
            << false
        }
        mmio_flags := u64(VMM_PAGE_WRITABLE | VMM_PAGE_PCD | VMM_PAGE_PWT) | vmm_nx_bit()
        if !vmm_map_page(vmm_kernel_pml4(), hpet.base_addr, hpet.base_addr, mmio_flags) {
            serial_puts("[SMP-HPET] FAIL: map HPET MMIO page failed\n")
            << false
        }
        smp_tlb_shootdown(hpet.base_addr)

        period_fs := arch.hpet_period_fs(hpet.base_addr)
        if period_fs == u64(0) || period_fs > u64(100000000) {
            serial_puts("[SMP-HPET] FAIL: invalid HPET period_fs\n")
            << false
        }
        arch.hpet_enable(hpet.base_addr)
        c0 := arch.hpet_counter(hpet.base_addr)
        $delta_ns := u64(0)
        $spins := 0
        while delta_ns < u64(1500000) && spins < 20000000 {
            arch.pause()
            c1 := arch.hpet_counter(hpet.base_addr)
            if c1 > c0 {
                delta_ns = arch.hpet_ticks_to_ns(c1 - c0, period_fs)
            }
            spins += 1
        }
        if delta_ns < u64(1000000) {
            serial_puts("[SMP-HPET] FAIL: HPET did not reach 1ms\n")
            << false
        }

        // FXSAVE / FXRSTOR SSE+FPU state round-trip test
        orig_ptr := ($&g_fxsave_orig[0]) as *raw u8
        test_ptr := ($&g_fxsave_test[0]) as *raw u8
        read_ptr := ($&g_fxsave_read[0]) as *raw u8
        mem.memset(orig_ptr, u8(0), 512)
        mem.memset(test_ptr, u8(0), 512)
        mem.memset(read_ptr, u8(0), 512)
        arch.fxsave(orig_ptr)
        mxcsr := *(((orig_ptr as u64) + u64(24)) as *raw u32)
        if (mxcsr & u32(0xFFFF)) == u32(0) {
            serial_puts("[SMP-HPET] FAIL: FXSAVE invalid MXCSR=0\n")
            << false
        }
        mem.memcpy(test_ptr, orig_ptr, 512)
        magic := 0x123456789ABCDEF0u64
        *(((test_ptr as u64) + u64(160)) as *raw u64) = magic
        arch.fxrstor(test_ptr)
        arch.fxsave(read_ptr)
        got_xmm0 := *(((read_ptr as u64) + u64(160)) as *raw u64)
        arch.fxrstor(orig_ptr)
        if got_xmm0 != magic {
            serial_puts("[SMP-HPET] FAIL: FXSAVE/FXRSTOR XMM0 round-trip mismatch\n")
            << false
        }

        // TicketLock-protected 8-slot AP Job Queue test (sum 100..800 = 3600)
        g_job_sum.store(u64(0))
        g_job_done.store(u64(0))
        for j in 0:8 {
            val := u64((j + 1) * 100)
            $pushed := false
            while !pushed {
                if true {
                    _jg := g_job_lock.acquire()
                    if (g_job_tail - g_job_head) < u64(8) {
                        slot := int(g_job_tail & u64(7))
                        g_job_queue[slot] = val
                        g_job_tail += u64(1)
                        pushed = true
                    }
                }
                if !pushed {
                    arch.pause()
                }
            }
        }
        $wait_j := 0
        while g_job_done.load() < u64(8) && wait_j < 20000000 {
            arch.pause()
            wait_j += 1
        }
        if g_job_done.load() != u64(8) || g_job_sum.load() != u64(3600) {
            serial_puts("[SMP-HPET] FAIL: AP Job Queue mismatch\n")
            << false
        }

        serial_puts("[SMP-HPET] period_fs=")
        serial_put_dec(int(period_fs))
        serial_puts(" delta_ns=")
        serial_put_dec(int(delta_ns))
        serial_puts(" fxsave_mxcsr=")
        serial_put_hex(u64(mxcsr))
        serial_puts(" ap_jobs=8 sum=")
        serial_put_dec(int(g_job_sum.load()))
        serial_puts(" OK\n")
    }
    << true
}
