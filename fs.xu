@main
$freestanding

#core/mem
#core/sync

pub const XUFS_MAGIC = 0x5346555830303130u64 // "XUFS0010" little-endian
pub const XUFS_SUPER_SECTOR = 4
pub const XUFS_INODE_START = 5
pub const XUFS_INODE_SECTORS = 3
pub const XUFS_INODES_PER_SECTOR = 8
pub const XUFS_MAX_INODES = 24
pub const XUFS_DATA_START = 8
pub const XUFS_TOTAL_SECTORS = 32768
pub const XUFS_MAX_NAME = 39

@repr("C")
pub struct XuFsSuper {
    pub magic u64
    pub version u32
    pub total_sectors u32
    pub inode_start u32
    pub inode_sectors u32
    pub data_start u32
    pub data_sectors u32
    pub file_count u32
    pub next_free_sector u32
}

@repr("C")
pub struct XuFsInode {
    pub used u32
    pub size u32
    pub start_sector u32
    pub sector_count u32
    pub flags u32
    pub reserved u32
    pub name [40]u8
}

static_assert(sizeof(XuFsSuper) == 40 && sizeof(XuFsInode) == 64 && offsetof(XuFsInode, name) == 24, "XuFS on-disk ABI mismatch")

@repr("C")
pub struct FsState {
    pub mounted u32
    pub pad u32
    pub super XuFsSuper
    pub lock sync.IrqSpinlock
}

@align(16)
static $g_fs_state FsState

@align(16)
static $fs_inodes [XUFS_MAX_INODES]XuFsInode

@align(16)
static $fs_sec_buf [512]u8

fn fs_state() *raw FsState {
    unsafe {
        << ($&g_fs_state) as *raw FsState
    }
}

fn fs_inode_at(idx int) *raw XuFsInode {
    unsafe {
        base := (($&fs_inodes[0]) as *raw XuFsInode) as usize
        << (base + usize(idx * sizeof(XuFsInode))) as *raw XuFsInode
    }
}

fn fs_name_matches(inode *raw XuFsInode, path *raw u8, path_len int) bool {
    if path_len <= 0 || path_len > XUFS_MAX_NAME {
        << false
    }
    unsafe {
        np := ((inode as usize) + usize(offsetof(XuFsInode, name))) as *raw u8
        $i := 0
        while i < path_len {
            c1 := *(((np as usize) + usize(i)) as *raw u8)
            c2 := *(((path as usize) + usize(i)) as *raw u8)
            if c1 != c2 {
                << false
            }
            i += 1
        }
        tail := *(((np as usize) + usize(path_len)) as *raw u8)
        << tail == u8(0)
    }
}

fn fs_flush_inode(idx int) bool {
    sec_off := idx / XUFS_INODES_PER_SECTOR
    sec_num := u64(XUFS_INODE_START + sec_off)
    unsafe {
        sbuf := ($&fs_sec_buf[0]) as *raw u8
        base_idx := sec_off * XUFS_INODES_PER_SECTOR
        mem.memcpy(sbuf, fs_inode_at(base_idx) as *raw u8, 512)
        << blk_write_sector(sec_num, sbuf)
    }
}

fn fs_flush_super(st *raw FsState) bool {
    unsafe {
        sbuf := ($&fs_sec_buf[0]) as *raw u8
        mem.memset(sbuf, u8(0), 512)
        mem.memcpy(sbuf, (&(*st).super) as *raw u8, sizeof(XuFsSuper))
        << blk_write_sector(u64(XUFS_SUPER_SECTOR), sbuf)
    }
}

pub fn fs_mount() bool {
    unsafe {
        st := fs_state()
        guard := (*st).lock.acquire()
        (*st).mounted = u32(0)

        sbuf := ($&fs_sec_buf[0]) as *raw u8
        if !blk_read_sector(u64(XUFS_SUPER_SECTOR), sbuf) {
            << false
        }
        sp := sbuf as *raw XuFsSuper
        if (*sp).magic != XUFS_MAGIC || (*sp).version != u32(1) {
            << false
        }
        mem.memcpy((&(*st).super) as *raw u8, sbuf, sizeof(XuFsSuper))

        $sec := 0
        while sec < XUFS_INODE_SECTORS {
            if !blk_read_sector(u64(XUFS_INODE_START + sec), sbuf) {
                << false
            }
            dst := fs_inode_at(sec * XUFS_INODES_PER_SECTOR) as *raw u8
            mem.memcpy(dst, sbuf, 512)
            sec += 1
        }
        (*st).mounted = u32(1)
        << true
    }
}

pub fn fs_file_count() int {
    unsafe {
        st := fs_state()
        if (*st).mounted == u32(0) {
            << 0
        }
        << int((*st).super.file_count)
    }
}

pub fn fs_inode_summary(idx int, out_size *raw u32, out_secs *raw u32, out_flags *raw u32, out_name *raw u8, max_name int) bool {
    if idx < 0 || idx >= XUFS_MAX_INODES {
        << false
    }
    unsafe {
        st := fs_state()
        guard := (*st).lock.acquire()
        if (*st).mounted == u32(0) {
            << false
        }
        ino := fs_inode_at(idx)
        if (*ino).used == u32(0) {
            << false
        }
        *out_size = (*ino).size
        *out_secs = (*ino).sector_count
        *out_flags = (*ino).flags
        np := ((ino as usize) + usize(offsetof(XuFsInode, name))) as *raw u8
        $lim := 40
        if max_name < lim { lim = max_name }
        mem.memcpy(out_name, np, lim)
        << true
    }
}

pub fn fs_list() {
    unsafe {
        st := fs_state()
        guard := (*st).lock.acquire()
        if (*st).mounted == u32(0) {
            serial_puts("[FS] Not mounted\n")
            <<
        }
        serial_puts("SIZE     SECS  PATH\n")
        $i := 0
        while i < XUFS_MAX_INODES {
            ino := fs_inode_at(i)
            if (*ino).used != u32(0) {
                sz := int((*ino).size)
                secs := int((*ino).sector_count)
                serial_put_dec(sz)
                serial_puts("     ")
                serial_put_dec(secs)
                serial_puts("     ")
                np := ((ino as usize) + usize(offsetof(XuFsInode, name))) as *raw u8
                $k := 0
                while k < XUFS_MAX_NAME {
                    ch := *(((np as usize) + usize(k)) as *raw u8)
                    if ch == u8(0) { <- }
                    serial_putc(ch)
                    k += 1
                }
                serial_puts("\n")
            }
            i += 1
        }
    }
}

pub fn fs_file_size(path *raw u8, path_len int) int {
    if path == 0 as *raw u8 {
        << -1
    }
    unsafe {
        st := fs_state()
        guard := (*st).lock.acquire()
        if (*st).mounted == u32(0) {
            << -1
        }
        $i := 0
        while i < XUFS_MAX_INODES {
            ino := fs_inode_at(i)
            if (*ino).used != u32(0) && fs_name_matches(ino, path, path_len) {
                << int((*ino).size)
            }
            i += 1
        }
    }
    << -1
}

pub fn fs_read(path *raw u8, path_len int, out *raw u8, max_len int) int {
    if path == 0 as *raw u8 || out == 0 as *raw u8 || max_len <= 0 {
        << -1
    }
    unsafe {
        st := fs_state()
        guard := (*st).lock.acquire()
        if (*st).mounted == u32(0) {
            << -1
        }
        $found := -1
        $i := 0
        while i < XUFS_MAX_INODES {
            ino := fs_inode_at(i)
            if (*ino).used != u32(0) && fs_name_matches(ino, path, path_len) {
                found = i
                <-
            }
            i += 1
        }
        if found < 0 {
            << -1
        }
        ino := fs_inode_at(found)
        $to_read := int((*ino).size)
        if to_read > max_len {
            to_read = max_len
        }
        sbuf := ($&fs_sec_buf[0]) as *raw u8
        $copied := 0
        $sec_idx := 0
        start := (*ino).start_sector
        sec_cnt := int((*ino).sector_count)
        while copied < to_read && sec_idx < sec_cnt {
            rem_bytes := to_read - copied
            rem_secs := sec_cnt - sec_idx
            $batch := rem_bytes / 512
            if batch > rem_secs {
                batch = rem_secs
            }
            if batch > 64 {
                batch = 64
            }
            if batch >= 1 {
                dst := ((out as usize) + usize(copied)) as *raw u8
                if !blk_read_sectors(u64(start) + u64(sec_idx), batch, dst) {
                    << -1
                }
                copied += batch * 512
                sec_idx += batch
            } else {
                if !blk_read_sector(u64(start) + u64(sec_idx), sbuf) {
                    << -1
                }
                dst := ((out as usize) + usize(copied)) as *raw u8
                mem.memcpy(dst, sbuf, rem_bytes)
                copied += rem_bytes
                sec_idx += 1
            }
        }
        << copied
    }
}

pub fn fs_read_at(path *raw u8, path_len int, offset int, out *raw u8, max_len int) int {
    if path == 0 as *raw u8 || out == 0 as *raw u8 || offset < 0 || max_len <= 0 {
        << -1
    }
    unsafe {
        st := fs_state()
        guard := (*st).lock.acquire()
        if (*st).mounted == u32(0) {
            << -1
        }
        $found := -1
        $i := 0
        while i < XUFS_MAX_INODES {
            ino := fs_inode_at(i)
            if (*ino).used != u32(0) && fs_name_matches(ino, path, path_len) {
                found = i
                <-
            }
            i += 1
        }
        if found < 0 {
            << -1
        }
        ino := fs_inode_at(found)
        fsize := int((*ino).size)
        if offset >= fsize {
            << 0
        }
        $to_read := fsize - offset
        if to_read > max_len {
            to_read = max_len
        }
        sbuf := ($&fs_sec_buf[0]) as *raw u8
        start := (*ino).start_sector
        sec_cnt := int((*ino).sector_count)
        $cur_off := offset
        $copied := 0
        while copied < to_read {
            sec_idx := cur_off / 512
            in_sec := cur_off % 512
            if sec_idx >= sec_cnt {
                <-
            }
            rem_bytes := to_read - copied
            rem_secs := sec_cnt - sec_idx
            if in_sec == 0 && rem_bytes >= 512 {
                $batch := rem_bytes / 512
                if batch > rem_secs {
                    batch = rem_secs
                }
                if batch > 64 {
                    batch = 64
                }
                dst := ((out as usize) + usize(copied)) as *raw u8
                if !blk_read_sectors(u64(start) + u64(sec_idx), batch, dst) {
                    << -1
                }
                step := batch * 512
                copied += step
                cur_off += step
            } else {
                if !blk_read_sector(u64(start) + u64(sec_idx), sbuf) {
                    << -1
                }
                $take := 512 - in_sec
                if take > rem_bytes {
                    take = rem_bytes
                }
                dst := ((out as usize) + usize(copied)) as *raw u8
                src := ((sbuf as usize) + usize(in_sec)) as *raw u8
                mem.memcpy(dst, src, take)
                copied += take
                cur_off += take
            }
        }
        << copied
    }
}

pub fn fs_write(path *raw u8, path_len int, data *raw u8, data_len int) bool {
    if path == 0 as *raw u8 || path_len <= 0 || path_len > XUFS_MAX_NAME || data_len < 0 {
        << false
    }
    if data_len > 0 && data == 0 as *raw u8 {
        << false
    }
    $needed_secs := (data_len + 511) / 512
    if needed_secs < 1 {
        needed_secs = 1
    }
    unsafe {
        st := fs_state()
        guard := (*st).lock.acquire()
        if (*st).mounted == u32(0) {
            << false
        }

        $idx := -1
        $free_idx := -1
        $i := 0
        while i < XUFS_MAX_INODES {
            ino := fs_inode_at(i)
            if (*ino).used != u32(0) && fs_name_matches(ino, path, path_len) {
                idx = i
                <-
            }
            if (*ino).used == u32(0) && free_idx < 0 {
                free_idx = i
            }
            i += 1
        }

        $start_sec := u32(0)
        $alloc_secs := u32(needed_secs)
        $is_new := false
        if idx >= 0 {
            ino := fs_inode_at(idx)
            if int((*ino).sector_count) >= needed_secs {
                start_sec = (*ino).start_sector
                alloc_secs = (*ino).sector_count
            } else {
                start_sec = (*st).super.next_free_sector
                if u32(start_sec) + u32(needed_secs) > (*st).super.total_sectors {
                    << false
                }
                (*st).super.next_free_sector = start_sec + u32(needed_secs)
            }
        } else {
            if free_idx < 0 {
                << false
            }
            idx = free_idx
            is_new = true
            start_sec = (*st).super.next_free_sector
            if u32(start_sec) + u32(needed_secs) > (*st).super.total_sectors {
                << false
            }
            (*st).super.next_free_sector = start_sec + u32(needed_secs)
            (*st).super.file_count += u32(1)
        }

        sbuf := ($&fs_sec_buf[0]) as *raw u8
        $written := 0
        $sec_idx := 0
        while sec_idx < needed_secs {
            mem.memset(sbuf, u8(0), 512)
            if written < data_len {
                $chunk := data_len - written
                if chunk > 512 {
                    chunk = 512
                }
                src := ((data as usize) + usize(written)) as *raw u8
                mem.memcpy(sbuf, src, chunk)
                written += chunk
            }
            if !blk_write_sector(u64(start_sec) + u64(sec_idx), sbuf) {
                << false
            }
            sec_idx += 1
        }

        ino := fs_inode_at(idx)
        (*ino).used = u32(1)
        (*ino).size = u32(data_len)
        (*ino).start_sector = start_sec
        (*ino).sector_count = alloc_secs
        (*ino).flags = u32(1)
        (*ino).reserved = u32(0)
        if is_new {
            np := ((ino as usize) + usize(offsetof(XuFsInode, name))) as *raw u8
            mem.memset(np, u8(0), 40)
            mem.memcpy(np, path, path_len)
        }

        if !fs_flush_inode(idx) {
            << false
        }
        << fs_flush_super(st)
    }
}

pub fn fs_self_test() bool {
    motd_path := "/etc/motd"
    persist_path := "/tmp/persist.txt"
    persist_payload := "XUFS-PERSIST-OK"

    page := pmm_alloc_frame()
    if page == u64(0) {
        << false
    }

    p_path := page as *raw u8
    p_data := (page + u64(128)) as *raw u8
    p_read := (page + u64(256)) as *raw u8
    $ok := true

    unsafe {
        for i in 0:motd_path.len {
            *(((p_path as usize) + usize(i)) as *raw u8) = u8(motd_path[i])
        }
        n0 := fs_read(p_path, motd_path.len, p_read, 128)
        expect_motd := "Welcome to Xu OS (XuFS on VirtIO-Blk)!\n"
        if n0 != expect_motd.len {
            ok = false
        } else {
            for i in 0:expect_motd.len {
                if int(*(((p_read as usize) + usize(i)) as *raw u8)) != (expect_motd[i] & 255) {
                    ok = false
                }
            }
        }

        if ok {
            for i in 0:persist_path.len {
                *(((p_path as usize) + usize(i)) as *raw u8) = u8(persist_path[i])
            }
            for i in 0:persist_payload.len {
                *(((p_data as usize) + usize(i)) as *raw u8) = u8(persist_payload[i])
            }
            if !fs_write(p_path, persist_path.len, p_data, persist_payload.len) {
                ok = false
            }
        }

        if ok {
            if !fs_mount() {
                ok = false
            } else {
                mem.memset(p_read, u8(0), 64)
                n1 := fs_read(p_path, persist_path.len, p_read, 64)
                if n1 != persist_payload.len || mem.memcmp(p_data, p_read, persist_payload.len) != 0 {
                    ok = false
                }
            }
        }
    }

    pmm_free_frame(page)
    << ok
}
