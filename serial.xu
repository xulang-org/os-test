@main
$freestanding

#core/arch
#core/mem
#core/sync

const COM1_PORT = 0x03F8
const SERIAL_RING_SIZE = 256

@repr("C")
pub struct SerialState {
    pub head u32
    pub tail u32
    pub rx_count u64
    pub tx_count u64
    pub lock sync.IrqSpinlock
}

static $g_serial_state SerialState
static $serial_ring [SERIAL_RING_SIZE]u8

fn serial_state() *raw SerialState {
    unsafe {
        << ($&g_serial_state) as *raw SerialState
    }
}

pub fn serial_init() {
    unsafe {
        mem.memset((($&g_serial_state) as *raw SerialState) as *raw u8, u8(0), sizeof(SerialState))
        mem.memset(($&serial_ring[0]) as *raw u8, u8(0), sizeof([SERIAL_RING_SIZE]u8))
        st := serial_state()
        *st = SerialState{
            head: u32(0),
            tail: u32(0),
            rx_count: u64(0),
            tx_count: u64(0),
            lock: sync.irq_spinlock_new()
        }

        // 16550 UART initialization: 115200 baud, 8N1, FIFO enabled, RX IRQ enabled
        arch.out8(u16(COM1_PORT + 1), u8(0x00)) // Disable interrupts
        arch.out8(u16(COM1_PORT + 3), u8(0x80)) // Enable DLAB
        arch.out8(u16(COM1_PORT + 0), u8(0x01)) // Divisor low (115200 baud)
        arch.out8(u16(COM1_PORT + 1), u8(0x00)) // Divisor high
        arch.out8(u16(COM1_PORT + 3), u8(0x03)) // 8 bits, no parity, 1 stop bit
        arch.out8(u16(COM1_PORT + 2), u8(0x07)) // Enable FIFO, clear RX/TX, 1-byte trigger
        arch.out8(u16(COM1_PORT + 4), u8(0x0B)) // IRQs enabled, RTS/DSR set
        arch.out8(u16(COM1_PORT + 1), u8(0x01)) // Enable Received Data Available IRQ
    }
}

pub fn serial_putc(c u8) {
    unsafe {
        while (arch.in8(u16(COM1_PORT + 5)) & u8(0x20)) == u8(0) {
            arch.pause()
        }
        arch.out8(u16(COM1_PORT), c)
        st := serial_state()
        (*st).tx_count += u64(1)
    }
    gui_term_putc(c)
}

pub fn serial_puts(msg string) {
    $i := 0
    while i < msg.len {
        ch := msg[i]
        if ch == 10 {
            serial_putc(u8(13))
        }
        serial_putc(u8(ch))
        i += 1
    }
}

pub fn serial_put_buf(buf *raw u8, len int) {
    $i := 0
    while i < len {
        unsafe {
            p := ((buf as int) + i) as *raw u8
            ch := *p
            if ch == u8(10) {
                serial_putc(u8(13))
            }
            serial_putc(ch)
        }
        i += 1
    }
}

fn serial_put_dec_pos(n int) {
    if n >= 10 {
        serial_put_dec_pos(n / 10)
    }
    serial_putc(u8(48 + (n % 10)))
}

pub fn serial_put_dec(val int) {
    if val == 0 {
        serial_putc(u8(48))
        <<
    }
    $n := val
    if n < 0 {
        serial_putc(u8(45))
        if n == -9223372036854775807 - 1 {
            serial_puts("9223372036854775808")
            <<
        }
        n = 0 - n
    }
    serial_put_dec_pos(n)
}

pub fn serial_put_hex_padded(val u64, digits int) {
    hex := "0123456789ABCDEF"
    $i := digits - 1
    while i >= 0 {
        nib := int((val >> u64(i * 4)) & u64(0xF))
        serial_putc(u8(hex[nib]))
        i -= 1
    }
}

pub fn serial_put_hex(val u64) {
    serial_puts("0x")
    if val == u64(0) {
        serial_putc(u8(48))
        <<
    }
    hex := "0123456789ABCDEF"
    $started := false
    $i := 15
    while i >= 0 {
        nib := int((val >> u64(i * 4)) & u64(0xF))
        if nib != 0 || started {
            started = true
            serial_putc(u8(hex[nib]))
        }
        i -= 1
    }
}

// Called only from IRQ4 trap_handler (IF=0). Must NOT acquire IrqSpinlock.
pub fn serial_on_irq() {
    unsafe {
        st := serial_state()
        while (arch.in8(u16(COM1_PORT + 5)) & u8(1)) != u8(0) {
            b := arch.in8(u16(COM1_PORT))
            head := int((*st).head)
            tail := int((*st).tail)
            next_head := (head + 1) & (SERIAL_RING_SIZE - 1)
            if next_head != tail {
                serial_ring[head] = b
                (*st).head = u32(next_head)
                (*st).rx_count += u64(1)
            }
        }
    }
}

pub fn serial_try_getc() int {
    unsafe {
        st := serial_state()
        guard := (*st).lock.acquire()
        head := int((*st).head)
        tail := int((*st).tail)
        if head != tail {
            b := int(serial_ring[tail])
            (*st).tail = u32((tail + 1) & (SERIAL_RING_SIZE - 1))
            << b
        }
        if (arch.in8(u16(COM1_PORT + 5)) & u8(1)) != u8(0) {
            b := int(arch.in8(u16(COM1_PORT)))
            (*st).rx_count += u64(1)
            << b
        }
    }
    << -1
}

pub fn serial_rx_count() u64 {
    unsafe {
        st := serial_state()
        guard := (*st).lock.acquire()
        << (*st).rx_count
    }
}

pub fn serial_tx_count() u64 {
    unsafe {
        st := serial_state()
        guard := (*st).lock.acquire()
        << (*st).tx_count
    }
}
