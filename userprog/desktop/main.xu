        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }
    s.place(lbl_fs_sel, 726.0, 182.0, 524.0, 34.0) or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }

    lbl_fs_motd := s.label("Content (/etc/motd): " + strings.trim_space(&motd_txt), 13.0, true) or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }
    s.place(lbl_fs_motd, 726.0, 224.0, 524.0, 44.0) or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }

    fs_paths := load_xufs_paths()
    btn_fs_run := s.button("Launch / Run Selected") or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }
    s.place(btn_fs_run, 726.0, 286.0, 252.0, 42.0) or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }

    btn_run_lnx := s.button("Run Linux App (ELF64)") or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }
    s.place(btn_run_lnx, 726.0, 342.0, 252.0, 40.0) or (err) {
