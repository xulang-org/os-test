        << 4
    }
    s.place(btn_run_mac, 994.0, 342.0, 252.0, 40.0) or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }

    lbl_out_hdr := s.label("Subprocess Output (/proc/app_out)", 14.0, false) or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }
    s.place(lbl_out_hdr, 726.0, 404.0, 524.0, 26.0) or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }

    lbl_out_1 := s.label("Click Run Linux App / Run macOS App or select a binary.", 13.0, true) or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }
    s.place(lbl_out_1, 726.0, 440.0, 524.0, 26.0) or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }

    lbl_out_2 := s.label("", 13.0, false) or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }
    s.place(lbl_out_2, 726.0, 472.0, 524.0, 26.0) or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }

    lbl_out_3 := s.label("", 13.0, true) or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }
    s.place(lbl_out_3, 726.0, 504.0, 524.0, 26.0) or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }

    // === Tab 2: Widget Showcase ===
    wg_left := s.card() or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }
    s.place(wg_left, 14.0, 124.0, 618.0, 660.0) or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }

    wg_hdr1 := s.label("Toggle & Choice Controls", 15.0, false) or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }
    s.place(wg_hdr1, 30.0, 138.0, 586.0, 28.0) or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }

    chk_a := s.checkbox("Strict W^X + NX Segment Isolation", true) or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }
    s.place(chk_a, 30.0, 182.0, 560.0, 36.0) or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }

    chk_b := s.checkbox("Hardware Demand Paging (#PF mmap)", true) or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }
    s.place(chk_b, 30.0, 228.0, 560.0, 36.0) or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }

    sw_demo := s.switch_control("Darwin + Linux Dual-ABI Syscalls", true) or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }
    s.place(sw_demo, 30.0, 278.0, 560.0, 38.0) or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }

    rad_grp := s.radio_group(&["Standard Theme Density", "Compact Inspector", "Presentation Mode"], 0) or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }
    s.place(rad_grp, 30.0, 336.0, 560.0, 138.0) or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }

    wg_right := s.card() or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }
    s.place(wg_right, 648.0, 124.0, 618.0, 660.0) or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }

    wg_hdr2 := s.label("Sliders, Steppers & Notifications", 15.0, false) or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }
    s.place(wg_hdr2, 664.0, 138.0, 586.0, 28.0) or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }

    lbl_slider := s.label("Interactive Value: 65%", 14.0, false) or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }
    s.place(lbl_slider, 664.0, 182.0, 586.0, 28.0) or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }

    sld_demo := s.slider(0.0, 100.0, 65.0) or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }
    s.place(sld_demo, 664.0, 222.0, 560.0, 36.0) or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }

    stp_demo := s.stepper(0.0, 100.0, 5.0, 65.0) or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }
    s.place(stp_demo, 664.0, 276.0, 200.0, 40.0) or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }

    prog_demo := s.progress(0.65) or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }
    s.place(prog_demo, 664.0, 338.0, 560.0, 18.0) or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }

    btn_toast := s.button("Trigger #ui/widgets Toast") or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }
    s.place(btn_toast, 664.0, 386.0, 260.0, 44.0) or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }

    toast_id := s.toast("Real #ui/widgets running in Ring 3!") or (err) {
        println("[UI-DESKTOP] widget err: " + err.msg())
        << 4
    }

    t0_ids := [ov_left, ov_title, lbl_ticks, lbl_mem, prog_mem, lbl_heap, prog_heap,
               lbl_status, btn_spawn, btn_persist, ov_right, ch_lbl, chart_id,
               ov_bot, lbl_arch1, lbl_arch2, lbl_arch3, lbl_arch4, lbl_arch5, lbl_arch6,
               ov_right2, lbl_snap_hdr, lbl_motd, lbl_files_cnt, lbl_bins, lbl_tip1, lbl_tip2]
    t1_ids := [fs_left, fs_hdr, fs_list, btn_fs_note, fs_right, fs_det_hdr, lbl_fs_sel, lbl_fs_motd,
               btn_fs_run, btn_run_lnx, btn_run_mac, lbl_out_hdr, lbl_out_1, lbl_out_2, lbl_out_3]
    t2_ids := [wg_left, wg_hdr1, chk_a, chk_b, sw_demo, rad_grp,
               wg_right, wg_hdr2, lbl_slider, sld_demo, stp_demo, prog_demo, btn_toast]

    set_tab_visibility($&s, 0, &t0_ids, &t1_ids, &t2_ids)

    // Populate initial /proc/stat & chart
    $last_stat_ticks := -1000
    stat0 := try_read("/proc/stat", "")
    t_init := parse_stat_field(&stat0, "ticks")
    free_init := parse_stat_field(&stat0, "free_frames")
    tot_init := parse_stat_field(&stat0, "total_frames")
    hused_init := parse_stat_field(&stat0, "heap_used")
    hsize_init := parse_stat_field(&stat0, "heap_size")
    tasks_init := parse_stat_field(&stat0, "tasks")
    dpf_init := parse_stat_field(&stat0, "demand_pfs")
    try_set_text($&s, lbl_ticks, "PIT 100Hz Ticks: " + str(t_init) + "   Tasks: " + str(tasks_init) + "   Demand #PF: " + str(dpf_init))
    if tot_init > 0 {
        try_set_text($&s, lbl_mem, "Physical RAM Free: " + str(free_init * 4 / 1024) + " MiB / " + str(tot_init * 4 / 1024) + " MiB")
        try_set_num($&s, prog_mem, f64(free_init) / f64(tot_init))
    }
    if hsize_init > 0 {
        try_set_text($&s, lbl_heap, "Kernel Heap Used: " + str(hused_init) + " B / " + str(hsize_init) + " B")
        try_set_num($&s, prog_heap, f64(hused_init) / f64(hsize_init))
    }
    series0 := build_telemetry_series(t_init, free_init, tot_init)
    try_set_chart_series($&s, chart_id, &series0)

    $fb_file := os.create("/dev/fb0") or (err) {
        println("[UI-DESKTOP] failed to open /dev/fb0: " + err.msg())
        << 5
    }

    if is_smoke {
        xdf1 := s.export_xdf() or (err) {
            println("[UI-DESKTOP] export_xdf err: " + err.msg())
            << 6
        }
        raster.render_xdf(&xdf1, &fstack, $&fatlas)
        raster.draw_cursor(660, 35)
        try_write_fb(&fb_file, &raster.pixels)
        h1 := raster.pixel_sample_hash()

        // Click the Dark/Light Theme switch via real #ui/widgets input dispatch
        ev_mv := make_ptr_ev(ui.EV_POINTER_MOVE, 660.0, 35.0, 0, 0, 0)
        ev_dn := make_ptr_ev(ui.EV_POINTER_DOWN, 660.0, 35.0, ui.BUTTON_LEFT, 1, 1)
        ev_up := make_ptr_ev(ui.EV_POINTER_UP, 660.0, 35.0, ui.BUTTON_LEFT, 0, 1)
        _ := try_handle_input($&s, &ev_mv)
        _ := try_handle_input($&s, &ev_dn)
        acts := try_handle_input($&s, &ev_up)
        for a in acts {
            if a.id == theme_sw && a.kind == widgets.ACTION_CHANGE {
                lst := widgets.light_styles()
                try_set_styles($&s, &lst)
            }
        }
        xdf2 := s.export_xdf() or (err) { << 7 }
        raster.render_xdf(&xdf2, &fstack, $&fatlas)
        raster.draw_cursor(660, 35)
        try_write_fb(&fb_file, &raster.pixels)
        h2 := raster.pixel_sample_hash()

        if xdf1.len < 200 || h1 == 0 || h1 == h2 {
            println("[UI-DESKTOP] smoke validation failed xdf1=" + str(xdf1.len) + " h1=" + str(h1) + " h2=" + str(h2))
            << 8
        }
        println("[UI-DESKTOP] ABI=" + abi_name + " xdf_bytes=" + str(xdf1.len) + " h1=" + str(h1) + " h2=" + str(h2) + " OK")
        try_close($&fb_file)
        << 0
    }

    // Interactive event loop
    $in_file := os.open("/dev/input") or (err) {
        println("[UI-DESKTOP] failed to open /dev/input: " + err.msg())
        << 9
    }

    $mx := 512
    $my := 384
    $btns := 0
    $cur_tab := 0
    $sel_fs_idx := 0
    $frame_seq := 0
    $need_present := true

    while true {
        $ev_batch := try_fd_read(&in_file, 512)
        $pending_actions := []widgets.Action{}
        $eoff := 0
        while eoff + 16 <= ev_batch.len {
            ekind := read_input_i32(&ev_batch, eoff)
            ex := read_input_i32(&ev_batch, eoff + 4)
            ey := read_input_i32(&ev_batch, eoff + 8)
            eval := read_input_i32(&ev_batch, eoff + 12)
            eoff += 16

            if ekind == 1 {
                mx = ex
                my = ey
                btns = eval
                ev := make_ptr_ev(ui.EV_POINTER_MOVE, f64(mx), f64(my), 0, btns, 0)
                acts := try_handle_input($&s, &ev)
                for a in acts { pending_actions.push(a) }
            } else if ekind == 2 {
                mx = ex
                my = ey
                btns = eval
                ev := make_ptr_ev(ui.EV_POINTER_DOWN, f64(mx), f64(my), ui.BUTTON_LEFT, btns, 1)
                acts := try_handle_input($&s, &ev)
                for a in acts { pending_actions.push(a) }
                need_present = true
            } else if ekind == 3 {
                mx = ex
                my = ey
                btns = eval
                ev := make_ptr_ev(ui.EV_POINTER_UP, f64(mx), f64(my), ui.BUTTON_LEFT, btns, 1)
                acts := try_handle_input($&s, &ev)
                for a in acts { pending_actions.push(a) }
                need_present = true
            } else if ekind == 6 {
                if eval == 27 {
                    try_close($&in_file)
                    try_close($&fb_file)
                    << 0
                }
                ev := ui.InputEvent{
                    kind: ui.EV_KEY_DOWN, window_id: 1, canvas_id: 1, generation: 1,
                    x: f64(mx), y: f64(my), dx: 0.0, dy: 0.0,
                    button: 0, buttons: btns, modifiers: 0,
                    key: eval, scan: 0, repeat: 0, click_count: 0, time_ns: 0
                }
                acts := try_handle_input($&s, &ev)
                for a in acts { pending_actions.push(a) }
                need_present = true
            }
        }

        try_advance($&s)
        timed := s.take_actions()
        for a in timed { pending_actions.push(a) }

        for a in pending_actions {
            if a.id == tabs_id && a.kind == widgets.ACTION_CHANGE {
                ntab := try_selected($&s, tabs_id)
                if ntab != cur_tab {
                    cur_tab = ntab
                    set_tab_visibility($&s, cur_tab, &t0_ids, &t1_ids, &t2_ids)
                    if cur_tab == 0 {
                        last_stat_ticks = -1000
                    }
                }
            } else if a.id == theme_sw && a.kind == widgets.ACTION_CHANGE {
                is_dark := try_toggle($&s, theme_sw)
                if is_dark {
                    dst := widgets.dark_styles()
                    try_set_styles($&s, &dst)
                } else {
                    lst := widgets.light_styles()
                    try_set_styles($&s, &lst)
                }
            } else if a.id == swap_btn && a.kind == widgets.ACTION_ACTIVATE {
                try_close($&in_file)
                try_close($&fb_file)
                if is_macos { << 71 }
                << 72
            } else if a.id == shell_btn && a.kind == widgets.ACTION_ACTIVATE {
                try_close($&in_file)
                try_close($&fb_file)
                << 0
            } else if a.id == power_btn && a.kind == widgets.ACTION_ACTIVATE {
                write_cmd("poweroff")
            } else if a.id == btn_spawn && a.kind == widgets.ACTION_ACTIVATE {
                write_cmd("spawn")
                try_set_text($&s, lbl_status, "Spawned dyn_worker kernel task!")
                last_stat_ticks = -1000
            } else if (a.id == btn_persist || a.id == btn_fs_note) && a.kind == widgets.ACTION_ACTIVATE {
                write_cmd("persist")
                try_set_text($&s, lbl_status, "Persisted /tmp/ui_note.txt to XuFS!")
                try_set_text($&s, lbl_fs_sel, "Saved /tmp/ui_note.txt -> reboot-safe XuFS")
            } else if a.id == fs_list && a.kind == widgets.ACTION_CHANGE {
                sel := try_selected($&s, fs_list)
                if sel >= 0 && sel < fs_lines.len {
                    sel_fs_idx = sel
                    try_set_text($&s, lbl_fs_sel, "Inode: " + fs_lines[sel])
                }
            } else if a.id == btn_fs_run && a.kind == widgets.ACTION_ACTIVATE {
                $sel_p := ""
                if sel_fs_idx >= 0 && sel_fs_idx < fs_paths.len {
                    sel_p = fs_paths[sel_fs_idx]
                }
                if sel_p == "/bin/desktop_linux" {
                    try_close($&in_file)
                    try_close($&fb_file)
                    << 71
                } else if sel_p == "/bin/desktop_macos" {
                    try_close($&in_file)
                    try_close($&fb_file)
                    << 72
                } else if sel_p == "/bin/linux_app" {
                    write_cmd("run_linux")
                    out_s := try_read("/proc/app_out", "exit=-1\n(no output)")
                    show_app_output($&s, lbl_out_1, lbl_out_2, lbl_out_3, &out_s)
                } else if sel_p == "/bin/macos_app" {
                    write_cmd("run_macos")
                    out_s := try_read("/proc/app_out", "exit=-1\n(no output)")
                    show_app_output($&s, lbl_out_1, lbl_out_2, lbl_out_3, &out_s)
                } else if sel_p == "/bin/hello.elf" {
                    write_cmd("run_hello")
                    out_s := try_read("/proc/app_out", "exit=-1\n(no output)")
                    show_app_output($&s, lbl_out_1, lbl_out_2, lbl_out_3, &out_s)
                } else if sel_p == "/bin/fault.elf" {
                    write_cmd("run_fault")
                    out_s := try_read("/proc/app_out", "exit=-1\n(no output)")
                    show_app_output($&s, lbl_out_1, lbl_out_2, lbl_out_3, &out_s)
                } else if sel_p == "/etc/motd" {
                    m := try_read("/etc/motd", "")
                    show_app_output($&s, lbl_out_1, lbl_out_2, lbl_out_3, &m)
                } else {
                    try_set_text($&s, lbl_out_1, "Selected asset: " + sel_p)
                    try_set_text($&s, lbl_out_2, "Not directly executable; pick /bin/*")
                    try_set_text($&s, lbl_out_3, "")
                }
            } else if a.id == btn_run_lnx && a.kind == widgets.ACTION_ACTIVATE {
                write_cmd("run_linux")
                out_s := try_read("/proc/app_out", "exit=-1\n(no output)")
                show_app_output($&s, lbl_out_1, lbl_out_2, lbl_out_3, &out_s)
            } else if a.id == btn_run_mac && a.kind == widgets.ACTION_ACTIVATE {
                write_cmd("run_macos")
                out_s := try_read("/proc/app_out", "exit=-1\n(no output)")
                show_app_output($&s, lbl_out_1, lbl_out_2, lbl_out_3, &out_s)
            } else if a.id == sld_demo && (a.kind == widgets.ACTION_CHANGE || a.kind == widgets.ACTION_COMMIT) {
                v := try_number($&s, sld_demo, 50.0)
                try_set_num($&s, stp_demo, v)
                try_set_num($&s, prog_demo, v / 100.0)
                try_set_text($&s, lbl_slider, "Interactive Value: " + str(int(v)) + "%")
            } else if a.id == stp_demo && a.kind == widgets.ACTION_CHANGE {
                v := try_number($&s, stp_demo, 50.0)
                try_set_num($&s, sld_demo, v)
                try_set_num($&s, prog_demo, v / 100.0)
                try_set_text($&s, lbl_slider, "Interactive Value: " + str(int(v)) + "%")
            } else if a.id == btn_toast && a.kind == widgets.ACTION_ACTIVATE {
                try_show_toast($&s, toast_id, "#ui/widgets running on " + abi_badge_txt + "!", time.duration(3 * time.second()))
            }
        }

        // Periodic telemetry refresh every ~100 ticks (1.0s) when System Overview tab is active
        frame_seq += 1
        if cur_tab == 0 && frame_seq % 40 == 0 {
            st_now := try_read("/proc/stat", "")
            t_now := parse_stat_field(&st_now, "ticks")
            if t_now - last_stat_ticks >= 100 || t_now < last_stat_ticks {
                last_stat_ticks = t_now
                free_n := parse_stat_field(&st_now, "free_frames")
                tot_n := parse_stat_field(&st_now, "total_frames")
                hu_n := parse_stat_field(&st_now, "heap_used")
                hs_n := parse_stat_field(&st_now, "heap_size")
                tk_n := parse_stat_field(&st_now, "tasks")
                pf_n := parse_stat_field(&st_now, "demand_pfs")
                try_set_text($&s, lbl_ticks, "PIT 100Hz Ticks: " + str(t_now) + "   Tasks: " + str(tk_n) + "   Demand #PF: " + str(pf_n))
                if tot_n > 0 {
                    try_set_text($&s, lbl_mem, "Physical RAM Free: " + str(free_n * 4 / 1024) + " MiB / " + str(tot_n * 4 / 1024) + " MiB")
                    try_set_num($&s, prog_mem, f64(free_n) / f64(tot_n))
                }
                if hs_n > 0 {
                    try_set_text($&s, lbl_heap, "Kernel Heap Used: " + str(hu_n) + " B / " + str(hs_n) + " B")
                    try_set_num($&s, prog_heap, f64(hu_n) / f64(hs_n))
                }
                ser_now := build_telemetry_series(t_now, free_n, tot_n)
                try_set_chart_series($&s, chart_id, &ser_now)
            }
        }

        if s.is_dirty() {
            xdf := try_export_xdf($&s)
            if xdf.len > 0 {
                raster.render_xdf(&xdf, &fstack, $&fatlas)
                need_present = true
            }
        }
        if need_present {
            try_write_fb(&fb_file, &raster.pixels)
            need_present = false
        }

        if ev_batch.len == 0 && !s.is_dirty() {
            time.sleep(10 * time.millisecond())
        }
    }

    << 0
}
