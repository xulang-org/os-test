@main

#os
#strconv
#strings
#time
#ui
#ui/chart
#ui/draw
#ui/font
#ui/widgets

fn parse_stat_field(stat &string, key string) int {
    pat := key + "="
    plen := pat.len
    idx := strings.index_of(stat, pat)
    if idx < 0 { << 0 }
    start := idx + plen
    $end := start
    while end < stat.len {
        c := stat[end] & 255
        if c < 48 || c > 57 { <- }
        end += 1
    }
    if end <= start { << 0 }
    tok := stat[start:end]
    res := strconv.atoi(&tok) or (err) { << 0 }
    << res
}

fn read_input_i32(buf &string, off int) int {
    $v := (buf[off] & 255) |
          ((buf[off + 1] & 255) << 8) |
          ((buf[off + 2] & 255) << 16) |
          ((buf[off + 3] & 255) << 24)
    if (v & 0x80000000) != 0 {
        v = v - 0x100000000
    }
    << v
}

fn write_cmd(cmd string) {
    _ := os.write("/dev/cmd", cmd) or (err) { << }
}

fn try_read(path string, fallback string) string {
    << os.read(path) or (err) { << fallback }
}

fn try_fd_read(f &os.File, max int) string {
    << f.read(max) or (err) { << "" }
}

fn try_write_fb(f &os.File, pixels &string) {
    _ := f.write(*pixels) or (err) { << }
}

fn try_close(f $&os.File) {
    _ := f.close() or (err) { << }
}

fn try_handle_input(s $&widgets.Screen, ev &ui.InputEvent) []widgets.Action {
    << s.handle_input(ev) or (err) { << []widgets.Action{} }
}

fn try_advance(s $&widgets.Screen) {
    _ := s.advance(time.instant()) or (err) { << }
}

fn try_export_xdf(s $&widgets.Screen) string {
