fn try_load_ttf(fstack $&font.FontStack, path string) {
    ttf_raw := try_read(path, "")
    if ttf_raw.len <= 1000 { << }
    ttf_bytes := font.bytes_from_string(&ttf_raw)
    ttf_face := font.parse_ttf(&ttf_bytes, 0, 1) or (err) {
        println("[UI-DESKTOP] ttf parse err: " + err.msg())
        <<
    }
    _ := fstack.add_face(ttf_face)
}

fn build_telemetry_series(ticks int, free_fr int, tot_fr int) []chart.ChartSeries {
    $s := widgets.chart_series(1, "Free RAM %", widgets.CHART_AREA)
    $pts := []chart.ChartPoint{}
    $base_pct := 85.0
    if tot_fr > 0 {
        base_pct = f64(free_fr * 100) / f64(tot_fr)
    }
    for i in 0:10 {
        wave := f64(((ticks / 10 + i * 3) % 7) - 3) * 0.4
        $val := base_pct + wave
        if val < 5.0 { val = 5.0 }
        if val > 99.0 { val = 99.0 }
        pts.push(widgets.chart_point(i + 1, f64(i + 1), val))
    }
    s.points = pts
    << [s]
}

fn safe_atoi(s &string) int {
    << strconv.atoi(s) or (err) { << 0 }
}

fn format_bytes(sz int) string {
    if sz >= 1048576 {
        tenths := (sz * 10 + 524288) / 1048576
        << str(tenths / 10) + "." + str(tenths % 10) + " MiB"
    }
    if sz >= 1024 {
        << str((sz + 512) / 1024) + " KiB"
    }
    << str(sz) + " B"
}

fn load_xufs_lines() []string {
    raw := try_read("/proc/files", "")
    $lines := []string{}
    if raw.len == 0 {
        lines.push("(empty)")
        << lines
    }
    parts := strings.split(&raw, "\n")
    for p in parts {
        if p.len > 0 {
            tab_idx := strings.index_of(&p, "\t")
            if tab_idx >= 0 {
                fpath := p[0:tab_idx]
                fsize_s := p[tab_idx + 1 : p.len]
                sz := safe_atoi(&fsize_s)
                lines.push(fpath + "   —   " + format_bytes(sz))
            } else {
                lines.push(p)
            }
        }
    }
    if lines.len == 0 { lines.push("(empty)") }
    << lines
}

fn load_xufs_paths() []string {
    raw := try_read("/proc/files", "")
    $paths := []string{}
    if raw.len == 0 {
        paths.push("")
        << paths
    }
    parts := strings.split(&raw, "\n")
    for p in parts {
        if p.len > 0 {
            tab_idx := strings.index_of(&p, "\t")
            if tab_idx >= 0 {
                paths.push(p[0:tab_idx])
            } else {
                paths.push(p)
            }
        }
    }
    if paths.len == 0 { paths.push("") }
    << paths
}

fn show_app_output(s $&widgets.Screen, lbl1 int, lbl2 int, lbl3 int, raw_out &string) {
    $lines := []string{}
    parts := strings.split(raw_out, "\n")
    for p in parts {
        tr := strings.trim_space(&p)
        if tr.len > 0 { lines.push(tr) }
    }
    if lines.len > 0 { try_set_text(s, lbl1, lines[0]) } else { try_set_text(s, lbl1, "(no output)") }
    if lines.len > 1 { try_set_text(s, lbl2, lines[1]) } else { try_set_text(s, lbl2, "") }
    if lines.len > 2 { try_set_text(s, lbl3, lines[2]) } else { try_set_text(s, lbl3, "") }
}

fn set_tab_visibility(s $&widgets.Screen, tab int,
                      t0_ids &[]int, t1_ids &[]int, t2_ids &[]int) {
    for id in t0_ids { s.set_visible(id, tab == 0) or (err) { -> } }
    for id in t1_ids { s.set_visible(id, tab == 1) or (err) { -> } }
    for id in t2_ids { s.set_visible(id, tab == 2) or (err) { -> } }
}

fn make_ptr_ev(kind int, x f64, y f64, btn int, btns int, clicks int) ui.InputEvent {
    << ui.InputEvent{
        kind: kind,
        window_id: 1,
        canvas_id: 1,
        generation: 1,
        x: x,
        y: y,
        dx: 0.0,
        dy: 0.0,
        button: btn,
        buttons: btns,
        modifiers: 0,
        key: 0,
        scan: 0,
        repeat: 0,
        click_count: clicks,
        time_ns: 0
    }
}

